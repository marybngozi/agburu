# Copy this file to .env for local development (git-ignored), or set the
# same variable in your hosting platform's build-time environment variables
# for a deployed build (e.g. Cloudflare Pages > Settings > Environment
# variables). Vite only inlines variables prefixed VITE_ into the client
# bundle, and only reads them at BUILD time, not at runtime — changing this
# value on a live Cloudflare Pages project requires a new deploy, not just
# an env var save.

# Base URL of the deployed backend API, including the /api path.
# Local dev default (used automatically if this is unset): http://localhost:3010/api
VITE_API_BASE=https://your-backend-host.example.com/api
